{
	"$schema": "../../node_modules/wrangler/config-schema.json",

	// `splitr-ai`: the AI Worker (REQ-E.4, ADR-0016 §6, ADR-0025). It does RAG
	// categorisation of line items, and later every other model call. The app
	// reaches it only through a service binding (REQ-M.8).
	"name": "splitr-ai",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": ["nodejs_compat"],

	// No public URL at all (REQ-E.4): the only way in is the service binding,
	// and every RPC call also carries the shared secret (ADR-0025 §3).
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },

	// Llama for generation, bge for embeddings. Always remote, even in dev.
	"ai": { "binding": "AI", "remote": true },

	// The same index search uses (ADR-0016 §7). Retrieval filters on groupId.
	// Remote in dev too: Vectorize has no local simulation.
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "splitr-search",
			"remote": true
		}
	],

	// REQ-F.4's daily neuron cap (ADR-0031): one Durable Object per UTC day.
	"durable_objects": {
		"bindings": [{ "name": "NEURON_BUDGET", "class_name": "NeuronBudget" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["NeuronBudget"] }],

	"vars": {
		// REQ-F.4 (ADR-0031): every model call goes through this AI Gateway, created
		// in the dashboard with caching, logs and a 100/min rate limit.
		// It must exist BEFORE this Worker deploys: an unknown id fails every
		// call (error 2001, measured). A new environment creates it first.
		"AI_GATEWAY_ID": "splitr",
		// The daily cap on the LLM route's neurons: 80% of the free 10,000.
		"AI_NEURON_CAP": "8000"
	},

	// READ ONLY, by discipline (ADR-0025 §5): the retrieved neighbours'
	// description and category. The app writes every result.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "splitr",
			"database_id": "bcbbea37-10b1-44d9-a8e6-4ad0103334a8"
		}
	]

	// AI_SHARED_SECRETS (comma-separated, ADR-0025 §3) is a secret:
	// `wrangler secret put AI_SHARED_SECRETS -c workers/ai/wrangler.jsonc`,
	// and `workers/ai/.dev.vars` locally. Never here.
}
