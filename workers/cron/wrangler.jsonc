{
	"$schema": "../../node_modules/wrangler/config-schema.json",

	// `splitr-cron`: the nightly sweep (REQ-E.6, ADR-0026). Reminders (UPSERT),
	// the category backfill and the search re-index. No public URL at all.
	"name": "splitr-cron",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": ["nodejs_compat"],

	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },

	// 02:30 UTC daily: before the 03:17 nightly E2E, off the busy hour.
	"triggers": { "crons": ["30 2 * * *"] },

	// Read and write: the reminders, the backfilled categories, expense_indexed.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "splitr",
			"database_id": "bcbbea37-10b1-44d9-a8e6-4ad0103334a8",
			"migrations_dir": "../../drizzle"
		}
	],

	// The AI Worker, for the backfill and the re-index (REQ-M.8: a service
	// binding, never public HTTP). Every call carries AI_SHARED_SECRET.
	"services": [{ "binding": "AI_WORKER", "service": "splitr-ai", "entrypoint": "AiService" }]

	// AI_SHARED_SECRET is a secret: `wrangler secret put AI_SHARED_SECRET -c
	// workers/cron/wrangler.jsonc` (the same value as the app's), and
	// workers/cron/.dev.vars locally. Without it the sweep still refreshes
	// reminders and skips the AI jobs.
}
