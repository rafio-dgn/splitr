{
	"$schema": "node_modules/wrangler/config-schema.json",

	// REQ-C.2's throwaway Worker. Not part of Splitr; nothing calls it. It lives
	// in workers/hello/ per ADR-0006 and is DELETED at build-plan step C.5,
	// both the deployed Worker and this directory. The teardown is part of the
	// requirement, not tidying.
	//
	// Named "splitr-hello" rather than C3's default "hello", so that in the
	// account's Worker list it's obvious what this is and what it belongs to.
	"name": "splitr-hello",
	"main": "src/index.ts",

	// Picked by C3 (the newest date the installed workerd supports).
	"compatibility_date": "2026-09-21",

	// Needed for `wrangler tail` to have anything to show, and REQ-C.2 asks
	// for this Worker to be watched with it.
	"observability": { "enabled": true },
	"upload_source_maps": true,

	// A var: configuration that's fine to read in review and in the dashboard.
	// It goes in the repo, versioned with the code that reads it.
	"vars": {
		"GREETING": "Hello from the edge"
	},

	// REQ-C.3: Workers AI as a binding, with no API key and no SDK. Calls
	// run on the account and are billed in neurons, which is why the route
	// that uses it sits behind HELLO_KEY.
	"ai": { "binding": "AI" }

	// A secret, HELLO_KEY, is NOT declared here. Secrets are set with
	// `wrangler secret put HELLO_KEY`, are encrypted at rest, can't be read back
	// through the dashboard or the API, and never appear in the repo
	// (CLAUDE.md §6). That difference is REQ-C.5 Q4. For `wrangler dev`, a local
	// value goes in `.dev.vars`, which is gitignored.
}
