# Copy to .env for local development.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters
SPLITR_DB_FILE=./.data/splitr.db

# BETTER_AUTH_URL: leave unset for local development.
#
# Better Auth derives its trusted origin from it, and Splitr runs on two ports —
# :3000 in the Docker container (ADR-0007) and :3100 under native `next dev`.
# Any pinned value breaks the other one (QA finding F-1). With it unset,
# `src/lib/auth.ts` trusts any loopback origin and resolves the base URL from
# the request host. Set it ONLY for a real deployed origin, e.g.
# BETTER_AUTH_URL=https://splitr.example.workers.dev
